<%- include('partials/header', { title: 'Noticias' }) %>

<h1>Últimas noticias</h1>

<% if (noticias.length === 0) { %>
  <p class="empty">Todavía no hay noticias publicadas.</p>
<% } else { %>
  <ul class="feed">
    <% noticias.forEach(n => { %>
      <li class="feed-item">
        <h2>
          <a href="/noticia/<%= n.id %>"><%= n.titulo %></a>
        </h2>
        <p class="meta">
          <time><%= n.fecha %></time>
          <% if (n.categorias.length) { %>
            ·
            <% n.categorias.forEach((c, i) => { %>
              <span class="tag"><%= c %></span><% if (i < n.categorias.length - 1) { %>, <% } %>
            <% }) %>
          <% } %>
        </p>
        <p class="excerpt">
          <%= n.contenido.length > 200 ? n.contenido.slice(0, 200) + '…' : n.contenido %>
        </p>
        <% if (n.enlace) { %>
          <p><a href="<%= n.enlace %>" target="_blank" rel="noopener">Fuente original →</a></p>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>